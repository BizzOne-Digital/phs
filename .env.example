# MongoDB — use Atlas in production so uploads persist across Vercel deploys
# Images are stored as binaries in MongoDB (StoredUpload) and served from /api/uploads/...
# Cloudinary is NOT required for admin uploads.
MONGODB_URI=mongodb://127.0.0.1:27017/phs

# Auth.js / NextAuth v5 (generate with: openssl rand -base64 32)
AUTH_SECRET=replace-with-long-random-secret
NEXTAUTH_SECRET=replace-with-long-random-secret
NEXTAUTH_URL=http://localhost:3000
AUTH_URL=http://localhost:3000

# Initial admin (used by seed script only)
ADMIN_EMAIL=admin@phs.local
ADMIN_PASSWORD=ChangeMeNow123!
ADMIN_NAME=PHS Admin

# Public site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudinary (optional legacy — admin uploads use MongoDB instead)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------------------
# Email — SMTP (recommended) for bookings + contact form alerts
# Recipient defaults to Site Settings email / contactFormRecipient (footer).
# Fallback recipient if settings are empty:
CONTACT_EMAIL=contact@premierhomeservice.com

# From address shown to customers (use the same Gmail you authenticate with)
EMAIL_FROM=Premier Home Services <contact@premierhomeservice.com>

# Gmail SMTP — create an App Password at:
# Google Account → Security → 2-Step Verification → App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=contact@premierhomeservice.com
SMTP_PASS=

# Optional: Resend instead of SMTP (leave empty when using SMTP)
RESEND_API_KEY=
